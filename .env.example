# Se copia este archivo como .env y ajusta los valores.
# Vite solo expone variables que empiezan con VITE_

# URL base del backend (sin barra final)
# Ejemplo: http://localhost:3000  o  https://api.escueladebrasil.com
VITE_API_BASE_URL=

# Tiempo máximo de espera por petición (milisegundos)
VITE_API_TIMEOUT_MS=15000

# true  = usa datos locales / mock (por defecto mientras no haya backend)
# false = consume la API real
VITE_API_USE_MOCK=true
